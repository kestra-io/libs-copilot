{"$schema":"http://json-schema.org/draft-07/schema#","$ref":"#/definitions/io.kestra.core.models.dashboards.Dashboard","definitions":{"io.kestra.core.models.dashboards.ChartOption":{"type":"object","properties":{"description":{"type":"string"},"displayName":{"type":"string","minLength":1},"width":{"type":"integer","default":6,"minimum":1,"maximum":12,"markdownDescription":"Default value is : `6`"}},"required":["displayName"]},"io.kestra.core.models.dashboards.Dashboard":{"type":"object","properties":{"charts":{"type":"array","items":{"$ref":"#/definitions/io.kestra.plugin.core.dashboard.chart.Markdown"}},"description":{"type":"string"},"id":{"type":"string","minLength":1},"timeWindow":{"allOf":[{"$ref":"#/definitions/io.kestra.core.models.dashboards.TimeWindow"},{"default":{"max":"PT8784H","default":"PT720H"},"markdownDescription":"Default value is : `max: PT8784H\ndefault: PT720H`"}]},"title":{"type":"string","minLength":1}},"required":["id","title"]},"io.kestra.core.models.dashboards.TimeWindow":{"type":"object","properties":{"default":{"type":"string","format":"duration"},"max":{"type":"string","format":"duration","default":"PT8784H","markdownDescription":"Default value is : `PT8784H`"}}},"io.kestra.plugin.core.dashboard.chart.Markdown":{"type":"object","properties":{"chartOptions":{"$ref":"#/definitions/io.kestra.core.models.dashboards.ChartOption"},"content":{"type":"string","title":"[DEPRECATED]Markdown content to display","$deprecated":true,"markdownDescription":"Use the String source instead"},"id":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9_-]*"},"source":{"anyOf":[{"$ref":"#/definitions/io.kestra.plugin.core.dashboard.chart.mardown.sources.FlowDescription-2"},{"$ref":"#/definitions/io.kestra.plugin.core.dashboard.chart.mardown.sources.Text-2"}]},"type":{"const":"io.kestra.plugin.core.dashboard.chart.Markdown"}},"required":["id","type"],"title":"Add context and insights with customizable Markdown text.","outputs":{},"markdownDescription":"##### Examples\n> Display custom content in place with Markdown.\n```yaml\ncharts:\n  - id: markdown_insight\n    type: io.kestra.plugin.core.dashboard.chart.Markdown\n    chartOptions:\n      displayName: Chart Insights\n      description: How to interpret this chart\n    content: |\n      ## Execution Success Rate\n      This chart displays the percentage of successful executions over time.\n\n      - A **higher success rate** indicates stable and reliable workflows.\n\n      - Sudden **drops** may signal issues in task execution or external dependencies.\n\n      - Use this insight to identify trends and optimize performance.\n\n```"},"io.kestra.plugin.core.dashboard.chart.mardown.sources.FlowDescription-1":{"type":"object","properties":{"flowId":{"type":"string","title":"Flow ID"},"namespace":{"type":"string","title":"Flow Namespace"},"type":{"type":"string","minLength":1,"pattern":"^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"}},"required":["flowId","namespace","type"],"title":"Flow Source to fetch description"},"io.kestra.plugin.core.dashboard.chart.mardown.sources.FlowDescription-2":{"allOf":[{"$ref":"#/definitions/io.kestra.plugin.core.dashboard.chart.mardown.sources.FlowDescription-1"},{"type":"object","properties":{"type":{"const":"FlowDescription"}},"required":["type"]}]},"io.kestra.plugin.core.dashboard.chart.mardown.sources.Text-1":{"type":"object","properties":{"content":{"type":"string","title":"Markdown content to display"},"type":{"type":"string","minLength":1,"pattern":"^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"}},"required":["type"],"title":"Markdown from text"},"io.kestra.plugin.core.dashboard.chart.mardown.sources.Text-2":{"allOf":[{"$ref":"#/definitions/io.kestra.plugin.core.dashboard.chart.mardown.sources.Text-1"},{"type":"object","properties":{"type":{"const":"Text"}},"required":["type"]}]}}}
